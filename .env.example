# Anthropic API key. Server-side only — it never reaches the browser.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Route through Vercel AI Gateway instead of calling Anthropic directly:
# put an AI Gateway key in ANTHROPIC_API_KEY above, then uncomment this line.
# The model id follows automatically (anthropic/claude-haiku-4.5).
# ANTHROPIC_BASE_URL=https://ai-gateway.vercel.sh

# Optional. Overrides the model on either route. Defaults to claude-haiku-4-5
# direct, anthropic/claude-haiku-4.5 through the gateway.
# ANTHROPIC_MODEL=claude-haiku-4-5
