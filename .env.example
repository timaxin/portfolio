# Ключ Anthropic API. Живёт только на сервере и никогда не попадает в браузер.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Необязательно. По умолчанию claude-opus-5.
# Публичный эндпоинт, который платит за каждый вопрос HR, дешевле держать на Haiku:
# ANTHROPIC_MODEL=claude-haiku-4-5

# Только для варианта «фронт на GitHub Pages»: URL задеплоенного Cloudflare Worker.
# Если не задан — фронт бьёт в собственный /api/chat.
# NEXT_PUBLIC_CHAT_ENDPOINT=https://portfolio-chat.<subdomain>.workers.dev

# Только для GitHub Pages вида username.github.io/<repo>.
# Для своего домена или username.github.io оставьте пустым.
# NEXT_PUBLIC_BASE_PATH=/portfolio
