# Credentials for the model provider. Server-side only — never reaches the browser.
# Direct Anthropic key (https://console.anthropic.com/settings/keys), or an
# AI Gateway key when LLM_BASE_URL points at the gateway.
LLM_API_KEY=sk-ant-...

# Optional. Route through Vercel AI Gateway instead of calling Anthropic directly.
# The model id follows automatically (anthropic/claude-haiku-4.5), and on a Vercel
# deployment LLM_API_KEY becomes optional — the injected VERCEL_OIDC_TOKEN authenticates.
# LLM_BASE_URL=https://ai-gateway.vercel.sh

# Optional. Overrides the model on either route. Defaults to claude-haiku-4-5
# direct, anthropic/claude-haiku-4.5 through the gateway.
# LLM_MODEL=claude-haiku-4-5
